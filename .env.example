# Copy to .env and fill in your values.

# Required: Anthropic API key. The planner and executor are Claude Agent SDK
# agents; the bundled `claude` CLI reads this from the process environment.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# WARNING: the executor runs with permission_mode="bypassPermissions" — it
# executes arbitrary Bash (uv/pytest/etc.) with no prompts. That's intended
# inside AMP's sandboxed per-job container. A LOCAL `uv run kickoff` with a real
# key will run the agent's shell commands on YOUR machine — only do it in a
# throwaway/sandboxed environment.

# Required only for the default @human_feedback classifier model below
# (openai/gpt-5.4-mini). Not needed if you point the classifier at a claude model.
# OPENAI_API_KEY=sk-your-openai-key-here

# Agent models (Claude Agent SDK). Defaults target the latest tier; the CLI
# accepts the "opus"/"sonnet" aliases too. Fallbacks kick in if a pinned ID
# isn't recognized by the bundled CLI version.
# CODEBUILDER_PLANNER_MODEL=claude-opus-4-8
# CODEBUILDER_EXECUTOR_MODEL=claude-sonnet-5
# CODEBUILDER_PLANNER_FALLBACK_MODEL=opus
# CODEBUILDER_EXECUTOR_FALLBACK_MODEL=sonnet

# Reasoning effort — the biggest token lever (low|medium|high|xhigh|max). The
# CLI's own default is xhigh (most expensive). Defaults: planner high, executor
# medium. Raise per-job for harder builds; lower to cut cost.
# CODEBUILDER_PLANNER_EFFORT=high
# CODEBUILDER_EXECUTOR_EFFORT=medium

# --- Cost controls -----------------------------------------------------------
# Per-run cost cap for the BUILD phase (executor + repair passes). Unset = no
# cap. When the executor's estimated spend crosses this, the build stops and
# still delivers the partial package with a deterministic CODEBUILDER_REPORT.md
# inside the zip. No wrap-up agent call is made. (Estimate, not exact billing;
# may overshoot by ~one turn. The planner is not included.)
# CODEBUILDER_MAX_RUN_COST_USD=50
# Per-MTok rates for the mid-run cost estimate. Defaults are derived from the
# executor model (Opus 5/25, Sonnet 3/15, Haiku 1/5) and skew to standard (not
# intro) pricing so the cap stops slightly early rather than late. Override only
# if your negotiated rates differ.
# CODEBUILDER_COST_PER_MTOK_INPUT=3
# CODEBUILDER_COST_PER_MTOK_OUTPUT=15
# Hard cap on executor turns (unset = run until done). Another way to bound a
# runaway/credit-draining build.
# CODEBUILDER_EXECUTOR_MAX_TURNS=200

# Model used by @human_feedback to classify plan replies (approve/amend/reject).
# CODEBUILDER_GUARDRAIL_LLM=openai/gpt-5.4-mini

# Final QA repairs: one repair pass by default after whole-package QA fails.
# CODEBUILDER_MAX_FINAL_QA_REPAIRS=1
# Full pytest always runs. Long customer suites get 40 minutes by default.
# CODEBUILDER_TEST_TIMEOUT_SECONDS=2400

# Optional: override the workspace root (defaults to ./workspaces).
# CODEBUILDER_WORKSPACE_ROOT=./workspaces

# Optional: override the history SQLite DB path (defaults to ./data/codebuilder_history.db).
# CODEBUILDER_HISTORY_DB=./data/codebuilder_history.db

# Disable the project_history SQLite log (cross-run planner priors). Set to
# false on ephemeral runtimes where the local filesystem doesn't persist
# across invocations (e.g. CrewAI AMP). Planner falls back to current inputs only.
# CODEBUILDER_HISTORY_ENABLED=true

# --- Human-in-the-loop -------------------------------------------------------
# Webhook URL that WebhookFeedbackProvider POSTs to when a plan pauses for
# approval. When unset, the flow falls back to an interactive console prompt.
# For the codebuilder-web Flask frontend, set this to:
#   https://<codebuilder-web-host>/webhooks/feedback_ready
# CODEBUILDER_APPROVAL_WEBHOOK=https://example.com/hooks/approvals

# Optional progress webhook for frontend SSE updates after each subtask and
# final QA step. When unset, progress reporting is skipped.
# CODEBUILDER_PROGRESS_WEBHOOK=https://<codebuilder-web-host>/webhooks/progress
# CODEBUILDER_PROGRESS_WEBHOOK_SECRET=shared-secret

# --- Artifact upload (S3) ----------------------------------------------------
# When CODEBUILDER_ARTIFACT_BUCKET is set, finalize() uploads the project zip
# to s3://<bucket>/<prefix>/<project_key>/<flow_id>/... even if QA failed, and
# writes 7-day presigned GET URLs into QAReport.artifact_urls. Per-file
# workspace uploads are optional and remain controlled separately.
# CODEBUILDER_ARTIFACT_BUCKET=crewai-fde

# Optional base prefix inside the bucket (useful for shared buckets).
# Example: "pedro/vivo-codebuilder" → objects land at
#   s3://crewai-fde/pedro/vivo-codebuilder/<project_key>/<flow_id>/...
# CODEBUILDER_ARTIFACT_PREFIX=pedro/vivo-codebuilder

# AWS credentials + region used for upload and presigned URL generation.
# The IAM user needs s3:PutObject + s3:GetObject on the prefix, e.g.:
#   "Resource": "arn:aws:s3:::crewai-fde/pedro/*"
# AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
